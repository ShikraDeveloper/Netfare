{
  "name": "netfare",
  "version": "1.0.6",
  "private": true,
  "license": "MIT",
  "description": "Local-first invoicing and double-entry accounting",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "restore": "node scripts/restore.js",
    "backup": "node scripts/backup.js",
    "reset-admin": "node scripts/reset-admin.js",
    "desktop": "node scripts/build-desktop.js run",
    "desktop:dist": "node scripts/build-desktop.js dist",
    "release:feed": "node scripts/release-feed.js",
    "website:zip": "rm -f netfare-website.zip && cd website && zip -qr ../netfare-website.zip . -x '.*'",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1"
  }
}
